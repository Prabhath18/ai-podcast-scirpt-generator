# ---------------------------------------------------------------------------
# Podcast Outline AI: server configuration. Copy this file to `server/.env` before running the app.
# (A root-level copy also works if you prefer to keep everything in one file;
# server/index.js loads server/.env first and falls back to the repo root.)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AI provider. Outlines are written by Gemini (the default) or Hugging Face.
# Demo mode needs none of this: the bundled demos work with every key blank.
# ---------------------------------------------------------------------------

# Which provider writes the outlines: "gemini" (default) or "huggingface".
LLM_PROVIDER=gemini

# Optional. If the provider above fails or is rate-limited, try this one once
# before reporting an error. Must be the OTHER provider. Leave blank for none.
LLM_FALLBACK_PROVIDER=

# Needed when Gemini is the provider or the fallback.
# Get a key at https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Needed when Hugging Face is the provider or the fallback.
# Create a fine-grained token at https://huggingface.co/settings/tokens/new?tokenType=fineGrained
# with the permission "Make calls to Inference Providers".
# Note: free accounts get only a small monthly credit (about $0.10 at the time
# of writing), so Gemini is the default.
HF_TOKEN=
# Any chat model served by Inference Providers, as "org/model". A suffix picks the
# routing: ":fastest" (default), ":cheapest", or a provider, e.g. ":nscale".
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Override the endpoint (default https://router.huggingface.co/v1).
# HF_BASE_URL=
# Give up on a request after this long. Models can cold-start. Default 90000.
# HF_TIMEOUT_MS=90000
# Cap on the model's reply length. Default 6000.
# HF_MAX_TOKENS=6000

# ---------------------------------------------------------------------------
# Rate limiting, proxies and logs
# ---------------------------------------------------------------------------

# Optional. Share rate-limit counters between several server instances through Redis
# (e.g. redis://default:password@host:6379, or rediss:// for TLS). Leave blank to count per
# instance in memory, which is all a single server needs. If Redis cannot be reached the
# server logs a warning and counts in memory until it can; it never fails to start.
REDIS_URL=

# Optional. How many reverse proxies sit in front of the API (Railway, Render and Heroku: 1).
# Without it every visitor behind a proxy looks like the proxy's own address, so they all share
# one rate-limit budget. Leave unset when the API is reached directly.
# TRUST_PROXY=1

# Optional. Log level: trace, debug, info (default), warn, error, fatal or silent.
# Logs are one JSON object per line, each tagged with the request id (reqId).
# LOG_LEVEL=info

# Optional. Adds recent news links to the Research panel. Wikipedia sources need
# no key and work without this. NewsAPI's free tier only answers requests from
# localhost and has a small daily quota, so treat it as a local-development
# extra; when the key is missing the news section is hidden entirely.
# Get one at https://newsapi.org/register
NEWS_API_KEY=

# Port the Express API listens on.
PORT=8787

# Path to the SQLite database file. Relative paths resolve from server/.
# On hosts with an ephemeral/temporary disk (e.g. some free Render/Railway
# tiers) this file -- and every saved account/project -- is lost on restart
# or redeploy unless the path points at a mounted persistent volume.
DATABASE_PATH=./data/podcast.sqlite

# Secret used to sign JWTs. Use a long random string in production, e.g.
# `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call the API with credentials.
# The Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# Set to "production" when deploying. Enables secure cookies (HTTPS only).
NODE_ENV=development
