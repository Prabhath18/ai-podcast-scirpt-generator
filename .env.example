# ---------------------------------------------------------------------------
# Podcast Outline AI: server configuration. Copy this file to `server/.env` before running the app.
# (A root-level copy also works if you prefer to keep everything in one file;
# server/index.js loads server/.env first and falls back to the repo root.)
# ---------------------------------------------------------------------------

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# Leave blank to run in demo-only mode (bundled sample outlines, no live
# generation). Never commit a real key.
GEMINI_API_KEY=

# Optional. Adds recent news links to the Research panel. Wikipedia sources need
# no key and work without this. NewsAPI's free tier only answers requests from
# localhost and has a small daily quota, so treat it as a local-development
# extra; when the key is missing the news section is hidden entirely.
# Get one at https://newsapi.org/register
NEWS_API_KEY=

# Port the Express API listens on.
PORT=8787

# Path to the SQLite database file. Relative paths resolve from server/.
# On hosts with an ephemeral/temporary disk (e.g. some free Render/Railway
# tiers) this file -- and every saved account/project -- is lost on restart
# or redeploy unless the path points at a mounted persistent volume.
DATABASE_PATH=./data/podcast.sqlite

# Secret used to sign JWTs. Use a long random string in production, e.g.
# `openssl rand -hex 32`.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call the API with credentials.
# The Vite dev server runs on 5173 by default.
CORS_ORIGIN=http://localhost:5173

# Set to "production" when deploying. Enables secure cookies (HTTPS only).
NODE_ENV=development
